{
  "name": "obsidian-base-board-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Base Board — Kanban board core + Obsidian plugin + Electron app.",
  "scripts": {
    "build:core": "cd packages/board-core && npm run build",
    "build:plugin": "cd plugins/obsidian-plugin && npm run build",
    "build:electron": "cd apps/electron-app && npm run build",
    "build": "npm run build:core && npm run build:plugin",
    "dev:plugin": "cd plugins/obsidian-plugin && npm run dev",
    "dev:electron": "cd apps/electron-app && npm run dev",
    "lint": "npm run lint:core && npm run lint:plugin",
    "lint:core": "cd packages/board-core && npm run typecheck",
    "lint:plugin": "cd plugins/obsidian-plugin && npm run lint",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"plugins/*/src/**/*.ts\"",
    "clean": "rm -rf packages/board-core/dist plugins/obsidian-plugin/main.js apps/electron-app/main.js apps/electron-app/renderer/main.js"
  },
  "devDependencies": {
    "prettier": "3.8.4"
  }
}
