{
  "name": "@base-board/board-core",
  "version": "1.0.0",
  "description": "Pure Kanban board logic — card, column, drag-drop, tags, and chip rendering.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "6.0.3"
  }
}
