{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2019",
    "allowJs": true,
    "strict": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "lib": ["DOM", "ES2019"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@base-board/board-core/*": ["../../packages/board-core/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
